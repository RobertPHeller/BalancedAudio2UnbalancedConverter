import FreeCAD as App
import Part, TechDraw, Mesh, Import
from FreeCAD import Base

import os
import sys
sys.path.append(os.path.dirname(__file__))

def debug(fmt,*args):
    print(fmt % args,file=sys.stderr)
    
class rcj_01x_smt(object):
    __socketod = 8.3
    __socketlen = 8.3
    __centZ = 6.5
    __backwidth = 11.0
    __backheight = 12.0
    __backdepth = 6.7
    def __init__(self,name,origin=Base.Vector(0,0,0)):
        self.name = name
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        self.origin = origin
        back = Part.makePlane(self.__backwidth,self.__backdepth,
                               origin.add(Base.Vector(-self.__backwidth/2,0,0))
                      ).extrude(Base.Vector(0,0,self.__backheight))
        socket = Part.makeCylinder(self.__socketod/2,
                                   self.__socketlen,
                                   origin.add(Base.Vector(
                                            0,-self.__socketlen,
                                            self.__centZ)),
                                   Base.Vector(0,1,0))
        self.object = back.fuse(socket)
    def show(self,doc=None):
        if doc==None:
            doc = App.activeDocument() 
        obj = doc.addObject("Part::Feature",self.name)
        obj.Shape = self.object
        obj.Label=self.name
        obj.ViewObject.ShapeColor=(0.75,0.75,0.75)


if __name__ == '__main__':
    doc = App.newDocument("rcj-01x-smt")
    part = rcj_01x_smt("rcj-01x-smt")
    part.show(doc)
    Gui.SendMsgToActiveView("ViewFit")
                        
